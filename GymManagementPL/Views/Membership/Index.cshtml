@model IEnumerable<MembershipViewModel>
@{
    ViewData["Title"] = "Memberships";
}

<div class="container-fluid">
    <header class="bg-primary text-white rounded-3 p-4 shadow-sm mt-5 mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-2">
            <div>
                <h2 class="mb-1 fw-semibold">Active Memberships</h2>
                <p class="mb-0 text-light opacity-75">Members That have Active Plans</p>
            </div>
            <div class="col text-end">
                <a asp-action="Create" class="btn btn-light">
                    <i class="fas fa-plus"></i> New Membership
                </a>
            </div>
        </div>
    </header>
    @if (TempData["successMessage"] != null){
    <div id="Alert" class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["successMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    }
    @if (TempData["errorMessage"] != null){
    <div id="Alert" class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["errorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    }

    <div class="card">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Member</th>
                            <th>Plan</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var membership in Model)
                        {
                            <tr>
                                <td class="align-middle">@membership.Name</td>
                                <td class="align-middle">@membership.PlanName</td>
                                <td class="align-middle">@membership.StartDate</td>
                                <td class="align-middle">@membership.EndDate</td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <form method="post" asp-action="Cancel" class="m-0">
                                            <input type="hidden" name="memberId" value="@membership.MemberId" />
                                            <input type="hidden" name="planId" value="@membership.PlanId" />
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="fas fa-times"></i> Cancel
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-person-workspace display-1 text-muted"></i>
                <h4 class="mt-3 text-muted">No Active Memberships Available</h4>
            </div>
            }
        </div>
    </div>
</div>
