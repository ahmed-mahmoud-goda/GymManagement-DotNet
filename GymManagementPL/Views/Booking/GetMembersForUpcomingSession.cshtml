@model IEnumerable<MemberBookingViewModel>

@{
    ViewData["Title"] = "Upcoming Session";
}
@if (TempData["successMessage"] != null)
{
    <div id="Alert" class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["successMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["errorMessage"] != null)
{
    <div id="Alert" class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["errorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<header class="bg-primary text-white rounded-3 p-4 shadow-sm mt-5 mb-4">
    <div class="d-flex flex-column flex-lg-row justify-content-center justify-content-lg-between align-items-start align-items-lg-center gap-2">
        <div>
            <h2 class="mb-1 fw-semibold">Session Members</h2>
            <p class="mb-0 text-light opacity-75">Members That Already Book Session</p>
        </div>
        <div class="text-start text-lg-end w-100 w-lg-auto">
            <a asp-action="Create" asp-route-id="@ViewBag.SessionId" class="btn btn-light">
                <i class="fas fa-plus me-1"></i> New Booking
            </a>
        </div>
    </div>
</header>
<div class="card shadow-sm">

    <div class="card-body">
        @if (Model != null && Model.Any())
        {
        <table class="table table-striped table-hover align-middle text-center">
            <thead>
                <tr>
                    <th>Member</th>
                    <th>Booking Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model)
                {
                    <tr>
                        <td>@booking.MemberName</td>
                        <td>@booking.CreatedAt</td>
                        <td>
                            <div class="d-flex justify-content-center gap-1">
                                <form asp-action="Cancel" asp-route-memberId="@booking.MemberId" asp-route-sessionId="@booking.SessionId" method="post" class="m-0">
                                    <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Are you sure you want to cancel this booking?');">
                                        <i class="fas fa-times"></i> Cancel
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        }
        else{
        <div class="text-center py-5">
            <i class="bi bi-person-workspace display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No Bookings Available</h4>
            <p class="text-muted">Add your first booking to get started</p>
        </div>
        }
    </div>

    <a asp-action="index" class="btn btn-fill ">Back to List</a>

</div>
